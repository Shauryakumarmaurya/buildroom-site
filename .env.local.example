# Supabase — applications are inserted into the `applications` table.
# Dashboard → Project Settings → Data API / API Keys.

# Your project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key (secret). Server-side only — never expose to the browser.
# It bypasses Row Level Security so the API route can insert rows.
SUPABASE_SERVICE_ROLE_KEY=

# Public client keys (safe to expose to the browser). Used for auth/login and
# for saving application drafts via row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
